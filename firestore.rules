rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada persona solo lee y escribe sus propios datos.
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // El atajo del iPhone no inicia sesión: puede CREAR un movimiento
    // solo si trae la clave secreta que la persona generó en la app.
    match /users/{uid}/movs/{id} {
      function claveAtajo() {
        return get(/databases/$(database)/documents/users/$(uid)/privado/atajo).data.clave;
      }
      function d() { return request.resource.data; }

      allow create: if request.auth == null
        && exists(/databases/$(database)/documents/users/$(uid)/privado/atajo)
        && d().clave is string && d().clave.size() >= 20 && d().clave == claveAtajo()
        && d().keys().hasOnly(['tipo', 'monto', 'categoria', 'descripcion', 'fecha', 'metodo', 'clave', 'origen'])
        && d().keys().hasAll(['tipo', 'monto', 'categoria', 'fecha', 'clave'])
        && d().tipo in ['gasto', 'ingreso']
        && d().monto is number && d().monto > 0 && d().monto < 1000000000000
        && d().categoria is string && d().categoria.size() <= 30
        && d().fecha is string && d().fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('descripcion' in d()) || (d().descripcion is string && d().descripcion.size() <= 80))
        && (!('metodo' in d()) || (d().metodo is string && d().metodo.size() <= 20))
        && (!('origen' in d()) || d().origen == 'atajo');
    }
  }
}

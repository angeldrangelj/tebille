import Shortcuts
// Versión del atajo de Apple Pay: 2
// Atajo "Tebille Apple Pay": lo ejecuta la automatización «Transacción» del iPhone cada vez que pagas con Wallet
// y anota la compra en Tebille sin preguntarte nada.
// Lo más fácil: en Tebille → Atajo y mensajes del banco → "Copiar atajo de Apple Pay" (ya trae tus datos).
// Si usas este archivo, cambia PEGA_AQUI_TU_USUARIO y PEGA_AQUI_TU_CLAVE por los que muestra Tebille.
// No compartas este código: contiene tu clave secreta.

// Tebille sabe si la tarjeta es de crédito o débito por su nombre en Wallet ("Nu Mastercard Debit" = débito).
// Si el nombre no lo dice, usa esto: "si" = crédito (se suma a la deuda), "no" = débito (baja tu saldo).
var EsCredito = "auto"

// La automatización le pasa al atajo los datos de la compra (valor, comercio y tarjeta)
var Compra = "${ShortcutInput}"
encodeURL(url: "${Compra}") >> CompraURL

var urlTebille = "https://tebille.pages.dev/api/sms?u=PEGA_AQUI_TU_USUARIO&k=PEGA_AQUI_TU_CLAVE&billetera=1&credito=${EsCredito}&texto=${CompraURL}"
downloadURL(url: urlTebille, method: GET, headers: {}, requestType: Json, requestJSON: {}) >> Respuesta
sendNotification(title: "Tebille", body: "${Respuesta}", sound: false)
